{
  "name": "throne-and-gold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "王座与黄金 —— 单机奇幻动态世界模拟",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "release": "pnpm build && node scripts/release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "tsc --noEmit && eslint . && prettier --check . && vitest run && vite build && node scripts/release.mjs"
  },
  "packageManager": "pnpm@11.28.5",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
